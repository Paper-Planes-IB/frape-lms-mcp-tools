        {
          "title": "CSS Selectors and Properties",
          "content": {
            "paragraphs": ["CSS uses selectors to target HTML elements and properties to style them:"],
            "code": [
              {
                "code": "body {\n    background-color: #f0f0f0;\n    font-family: Arial, sans-serif;\n}\n\nh1 {\n    color: #333;\n    text-align: center;\n}",
                "language": "css"
              }
            ]
          }
