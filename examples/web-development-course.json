        {
          "title": "HTML Structure",
          "content": {
            "paragraphs": ["Every HTML document follows a basic structure:"],
            "code": [
              {
                "code": "<!DOCTYPE html>\n<html>\n<head>\n    <title>My Page</title>\n</head>\n<body>\n    <h1>Hello World</h1>\n</body>\n</html>",
                "language": "html"
              }
            ]
          }
